# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL connection string (or any PostgreSQL URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=8h

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Public URL of the frontend (no trailing slash)
PRODUCTION_URL=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Gmail: use an App Password (not your account password)
SMTP_PASS=your-app-password

# Email address that receives contact form notifications
ADMIN_EMAIL=admin@yourdomain.com

# ── Admin panel URL ───────────────────────────────────────────────────────────
# Used in notification emails to link back to the admin panel (no trailing slash)
ADMIN_URL=https://yourdomain.com
