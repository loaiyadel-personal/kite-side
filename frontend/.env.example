# ── API ───────────────────────────────────────────────────────────────────────
# Full URL of the backend API including /api suffix (no trailing slash)
# Production example: https://api.yourdomain.com/api
# NOTE: If this is a cross-origin URL, add it to connect-src in next.config.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Phone number without + prefix, used for wa.me links
NEXT_PUBLIC_WHATSAPP_NUMBER=201116407080

# ── Third-party widgets ───────────────────────────────────────────────────────
# Not a secret — appears in client-side code
NEXT_PUBLIC_WINDFINDER_SPOT_ID=ras-sudr

# Google Maps API key (only needed if you switch from embed to JS Maps API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here
